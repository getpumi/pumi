# The first workflow, from spec to merge (decision 0171), as a first draft to
# tune once it runs. It is built into the release and pinned with the kernel
# version (decision 0166); the schema is pumi.workflow.v1.Workflow (decisions
# 0167 and 0168).
#
# For a trigger, the kernel asks the control plane about each transition of
# that trigger in the order listed here and fires the first one allowed. The
# last transition of each trigger is guarded by escalate or cancel, which are
# always allowed unless an invariant forbids them, so a plan always has a move
# (decisions 0169 and 0177). A gate state goes to the next state on its gate's
# action, back to its work state on retry, and to its own escalated state on
# escalate. A state that is not a gate goes on with advance, which the hard
# caps stop between stages, and otherwise escalates.
#
# A state that starts an agent run or an external action runs it again as a
# new invocation when it is in doubt, on retry, which the attempts and the hard
# caps guard; otherwise it escalates. A check in doubt runs again, so its state
# has no transition on in_doubt (decision 0191).
#
# A state that starts an invocation escalates when the invocation reaches its
# wall-time limit, on cap_reached (decision 0203).
#
# A state that starts an invocation runs it again as a new invocation when it
# fails, on retry, which the attempts and the hard caps guard; otherwise it
# escalates (decision 0235).
#
# The task of an agent run or an external action is the text file
# <task>.md beside this file; the task of a check is its task id, which
# names the operation of the check program (decision 0297).
#
# The archive step of the project places the archive state (decisions 0278
# and 0296): a transition that lists archive_steps holds only under them.
# After implementing, the default, the change is archived before the
# checks. After the conformance audit, it is archived after the audit, and
# the archived tree goes through the checks again, in the archived-* states,
# before approval. Off, there is no archive state, and a person archives the
# change by hand. Every fix loop goes back to implementing, so a later round
# runs the archive step again, which checks that the archive is unchanged.
name: "spec-to-merge"
version: "1"
initial: "spec"

# The superstate that holds every state of a plan that is not finished. A
# cancel.requested for the plan goes to cancelled from any of them, guarded by
# cancel, which the core policy core.cancel permits for the kernel (decisions
# 0170 and 0177).
states {
  name: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.cancel.requested" }
    target: "cancelled"
    action: "cancel"
  }
}

# 1. Spec (initial): the spec adapter validates the OpenSpec change of the
# plan and reports spec.valid (decision 0172), with the narratives (decision
# 0279), as the check program that the configuration names for spec
# (decision 0272). To planning on the spec gate;
# otherwise escalate. There is no retry, because only a person can fix the
# spec.
states {
  name: "spec"
  parent: "active"
  gate: "spec"
  invoke {
    role: ROLE_GATE
    kind: KIND_CHECK
    component: "spec"
    task: "validate-spec"
    output_message: "pumi.workflow.v1.SpecCheckOutput"
  }
  transitions {
    trigger { result {} }
    target: "planning"
    action: "spec"
  }
  transitions {
    trigger { result {} }
    target: "spec-escalated"
    action: "escalate"
  }
  transitions {
    trigger { cap_reached {} }
    target: "spec-escalated"
    action: "escalate"
  }
  transitions {
    trigger { failed {} }
    target: "spec"
    action: "retry"
  }
  transitions {
    trigger { failed {} }
    target: "spec-escalated"
    action: "escalate"
  }
}

# Spec, escalated: wait for a person (decision 0170). An override goes on to
# planning, decided again by the spec gate, which now reads the override. An
# answer goes back to spec, decided by resume, which reads the usage and the
# hard caps; the answer goes into the next invocation's input. Each trigger
# ends in escalate, so a denied decision keeps the plan here. After an answer
# the spec adapter validates the change again.
states {
  name: "spec-escalated"
  parent: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.override.recorded" }
    target: "planning"
    action: "spec"
  }
  transitions {
    trigger { event: "dev.getpumi.override.recorded" }
    target: "spec-escalated"
    action: "escalate"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "spec"
    action: "resume"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "spec-escalated"
    action: "escalate"
  }
}

# 2. Planning: an agent writes the plan, with its declared paths and any open
# questions, each with the agent's own answer. To a second opinion on ask,
# which is allowed only when questions.open is above zero; otherwise to plan
# review on advance; otherwise escalate.
states {
  name: "planning"
  parent: "active"
  invoke {
    role: ROLE_AGENT
    kind: KIND_HARNESS
    model_role: "planner"
    task: "plan"
    output_message: "pumi.workflow.v1.PlanningOutput"
  }
  transitions {
    trigger { result {} }
    target: "second-opinion"
    action: "ask"
  }
  transitions {
    trigger { result {} }
    target: "plan-review"
    action: "advance"
  }
  transitions {
    trigger { result {} }
    target: "planning-escalated"
    action: "escalate"
  }
  transitions {
    trigger { in_doubt {} }
    target: "planning"
    action: "retry"
  }
  transitions {
    trigger { in_doubt {} }
    target: "planning-escalated"
    action: "escalate"
  }
  transitions {
    trigger { cap_reached {} }
    target: "planning-escalated"
    action: "escalate"
  }
  transitions {
    trigger { failed {} }
    target: "planning"
    action: "retry"
  }
  transitions {
    trigger { failed {} }
    target: "planning-escalated"
    action: "escalate"
  }
}

# Planning, escalated: wait for a person. Planning escalates when advance is
# denied, as by the hard caps. An answer goes back to planning, decided by
# resume, which reads the usage and the hard caps; the answer goes into the
# next invocation's input. A denied resume keeps the plan here.
states {
  name: "planning-escalated"
  parent: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "planning"
    action: "resume"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "planning-escalated"
    action: "escalate"
  }
}

# 3. Second opinion: an independent invocation answers each open question of
# the planning output. Back to planning with the answers on the ambiguity
# gate; otherwise escalate, and a person decides. Ambiguity is escalated only
# from planning in the MVP (decision 0171).
states {
  name: "second-opinion"
  parent: "active"
  gate: "ambiguity"
  invoke {
    role: ROLE_AGENT
    kind: KIND_HARNESS
    model_role: "second-opinion"
    task: "answer-questions"
    output_message: "pumi.workflow.v1.SecondOpinion"
    narratives: true
  }
  transitions {
    trigger { result {} }
    target: "planning"
    action: "ambiguity"
  }
  transitions {
    trigger { result {} }
    target: "second-opinion-escalated"
    action: "escalate"
  }
  transitions {
    trigger { in_doubt {} }
    target: "second-opinion"
    action: "retry"
  }
  transitions {
    trigger { in_doubt {} }
    target: "second-opinion-escalated"
    action: "escalate"
  }
  transitions {
    trigger { cap_reached {} }
    target: "second-opinion-escalated"
    action: "escalate"
  }
  transitions {
    trigger { failed {} }
    target: "second-opinion"
    action: "retry"
  }
  transitions {
    trigger { failed {} }
    target: "second-opinion-escalated"
    action: "escalate"
  }
}

# Second opinion, escalated: wait for a person (decision 0170). An override
# goes on to planning, decided again by the ambiguity gate, which now reads
# the override. An answer goes back to planning, decided by resume, which
# reads the usage and the hard caps; the answer goes into the next
# invocation's input. Each trigger ends in escalate, so a denied decision
# keeps the plan here.
states {
  name: "second-opinion-escalated"
  parent: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.override.recorded" }
    target: "planning"
    action: "ambiguity"
  }
  transitions {
    trigger { event: "dev.getpumi.override.recorded" }
    target: "second-opinion-escalated"
    action: "escalate"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "planning"
    action: "resume"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "second-opinion-escalated"
    action: "escalate"
  }
}

# 4. Plan review (gate role): as many reviews as the profile's reviewers
# setting, and the result fires when all have finished (decision 0138). To
# implementing on the planReview gate; otherwise retry to planning; otherwise
# escalate.
states {
  name: "plan-review"
  parent: "active"
  gate: "planReview"
  invoke {
    role: ROLE_GATE
    kind: KIND_HARNESS
    model_role: "plan-reviewer"
    task: "review-plan"
    output_message: "pumi.events.v1.VerdictRecorded"
    narratives: true
  }
  transitions {
    trigger { result {} }
    target: "implementing"
    action: "planReview"
  }
  transitions {
    trigger { result {} }
    target: "planning"
    action: "retry"
  }
  transitions {
    trigger { result {} }
    target: "plan-review-escalated"
    action: "escalate"
  }
  transitions {
    trigger { in_doubt {} }
    target: "plan-review"
    action: "retry"
  }
  transitions {
    trigger { in_doubt {} }
    target: "plan-review-escalated"
    action: "escalate"
  }
  transitions {
    trigger { cap_reached {} }
    target: "plan-review-escalated"
    action: "escalate"
  }
  transitions {
    trigger { failed {} }
    target: "plan-review"
    action: "retry"
  }
  transitions {
    trigger { failed {} }
    target: "plan-review-escalated"
    action: "escalate"
  }
}

# Plan review, escalated: wait for a person (decision 0170). An override goes
# on to implementing, decided again by the planReview gate, which now reads
# the override. An answer goes back to planning, decided by resume, which
# reads the usage and the hard caps; the answer goes into the next
# invocation's input. Each trigger ends in escalate, so a denied decision
# keeps the plan here.
states {
  name: "plan-review-escalated"
  parent: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.override.recorded" }
    target: "implementing"
    action: "planReview"
  }
  transitions {
    trigger { event: "dev.getpumi.override.recorded" }
    target: "plan-review-escalated"
    action: "escalate"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "planning"
    action: "resume"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "plan-review-escalated"
    action: "escalate"
  }
}

# 5. Implementing: an agent makes the change in the workspace. On advance,
# to archiving when the project archives after implementing, and to
# checking otherwise; otherwise escalate. An agent that finds a question here fails its
# run, and the retry is a new attempt (decision 0171).
states {
  name: "implementing"
  parent: "active"
  invoke {
    role: ROLE_AGENT
    kind: KIND_HARNESS
    model_role: "implementer"
    task: "implement"
    output_message: "pumi.workflow.v1.ImplementationOutput"
  }
  transitions {
    trigger { result {} }
    target: "archiving"
    action: "advance"
    archive_steps: ARCHIVE_STEP_AFTER_IMPLEMENTING
  }
  transitions {
    trigger { result {} }
    target: "checking"
    action: "advance"
    archive_steps: [ARCHIVE_STEP_AFTER_CONFORMANCE, ARCHIVE_STEP_OFF]
  }
  transitions {
    trigger { result {} }
    target: "implementing-escalated"
    action: "escalate"
  }
  transitions {
    trigger { in_doubt {} }
    target: "implementing"
    action: "retry"
  }
  transitions {
    trigger { in_doubt {} }
    target: "implementing-escalated"
    action: "escalate"
  }
  transitions {
    trigger { cap_reached {} }
    target: "implementing-escalated"
    action: "escalate"
  }
  transitions {
    trigger { failed {} }
    target: "implementing"
    action: "retry"
  }
  transitions {
    trigger { failed {} }
    target: "implementing-escalated"
    action: "escalate"
  }
}

# Implementing, escalated: wait for a person. Implementing escalates when
# advance is denied, as by the hard caps. An answer goes back to implementing,
# decided by resume, which reads the usage and the hard caps; the answer goes
# into the next invocation's input. A denied resume keeps the plan here.
states {
  name: "implementing-escalated"
  parent: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "implementing"
    action: "resume"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "implementing-escalated"
    action: "escalate"
  }
}

# 5a. Archiving (decision 0278): the spec check's program archives the
# plan's change in the workspace with the task archive-change (decision
# 0284), or on a later round checks that the archive equals the archive of
# the change from the base tree (decision 0285). Its result carries the
# workspace's tree and no output (decision 0282). Under the archive step
# after implementing, to checking on advance; after the conformance audit,
# to archived-checking; otherwise escalate. The answer of a person runs it
# again.
states {
  name: "archiving"
  parent: "active"
  invoke {
    role: ROLE_GATE
    kind: KIND_CHECK
    component: "spec"
    task: "archive-change"
    returns_tree: true
  }
  transitions {
    trigger { result {} }
    target: "checking"
    action: "advance"
    archive_steps: ARCHIVE_STEP_AFTER_IMPLEMENTING
  }
  transitions {
    trigger { result {} }
    target: "archived-checking"
    action: "advance"
    archive_steps: ARCHIVE_STEP_AFTER_CONFORMANCE
  }
  transitions {
    trigger { result {} }
    target: "archiving-escalated"
    action: "escalate"
  }
  transitions {
    trigger { cap_reached {} }
    target: "archiving-escalated"
    action: "escalate"
  }
  transitions {
    trigger { failed {} }
    target: "archiving"
    action: "retry"
  }
  transitions {
    trigger { failed {} }
    target: "archiving-escalated"
    action: "escalate"
  }
}

# Archiving, escalated: wait for a person. Archiving escalates when the
# archive fails, as when the change does not archive or a later round finds
# that the archive changed, or when advance is denied. An answer goes back
# to archiving, decided by resume, which reads the usage and the hard caps.
# A denied resume keeps the plan here.
states {
  name: "archiving-escalated"
  parent: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "archiving"
    action: "resume"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "archiving-escalated"
    action: "escalate"
  }
}

# 6. Checking: a check runs VERIFY, the path checks, the metrics and DCO,
# which produce their facts. To scope on advance; otherwise escalate.
states {
  name: "checking"
  parent: "active"
  invoke {
    role: ROLE_GATE
    kind: KIND_CHECK
    component: "checks"
    task: "run-checks"
    output_message: "pumi.workflow.v1.CheckingOutput"
  }
  transitions {
    trigger { result {} }
    target: "scope"
    action: "advance"
  }
  transitions {
    trigger { result {} }
    target: "checking-escalated"
    action: "escalate"
  }
  transitions {
    trigger { cap_reached {} }
    target: "checking-escalated"
    action: "escalate"
  }
  transitions {
    trigger { failed {} }
    target: "checking"
    action: "retry"
  }
  transitions {
    trigger { failed {} }
    target: "checking-escalated"
    action: "escalate"
  }
}

# Checking, escalated: wait for a person. Checking escalates when advance is
# denied, as by the hard caps. An answer goes back to checking, decided by
# resume, which reads the usage and the hard caps; the answer goes into the
# next invocation's input. A denied resume keeps the plan here.
states {
  name: "checking-escalated"
  parent: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "checking"
    action: "resume"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "checking-escalated"
    action: "escalate"
  }
}

# 7a. Scope: a state that only decides, on entered: no changed path is outside
# the plan's declared paths. To budgets on the scope gate; otherwise retry to
# implementing; otherwise escalate.
states {
  name: "scope"
  parent: "active"
  gate: "scope"
  wait {}
  transitions {
    trigger { entered {} }
    target: "budgets"
    action: "scope"
  }
  transitions {
    trigger { entered {} }
    target: "implementing"
    action: "retry"
  }
  transitions {
    trigger { entered {} }
    target: "scope-escalated"
    action: "escalate"
  }
}

# Scope, escalated: wait for a person (decision 0170). An override goes on to
# budgets, decided again by the scope gate, which now reads the override. An
# answer goes back to implementing, decided by resume, which reads the usage
# and the hard caps; the answer goes into the next invocation's input. Each
# trigger ends in escalate, so a denied decision keeps the plan here.
states {
  name: "scope-escalated"
  parent: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.override.recorded" }
    target: "budgets"
    action: "scope"
  }
  transitions {
    trigger { event: "dev.getpumi.override.recorded" }
    target: "scope-escalated"
    action: "escalate"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "implementing"
    action: "resume"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "scope-escalated"
    action: "escalate"
  }
}

# 7b. Budgets: a state that only decides, on entered: no metric is over the
# profile's thresholds. To dco on the budgets gate; otherwise retry to
# implementing; otherwise escalate.
states {
  name: "budgets"
  parent: "active"
  gate: "budgets"
  wait {}
  transitions {
    trigger { entered {} }
    target: "dco"
    action: "budgets"
  }
  transitions {
    trigger { entered {} }
    target: "implementing"
    action: "retry"
  }
  transitions {
    trigger { entered {} }
    target: "budgets-escalated"
    action: "escalate"
  }
}

# Budgets, escalated: wait for a person (decision 0170). An override goes on
# to dco, decided again by the budgets gate, which now reads the override. An
# answer goes back to implementing, decided by resume, which reads the usage
# and the hard caps; the answer goes into the next invocation's input. Each
# trigger ends in escalate, so a denied decision keeps the plan here.
states {
  name: "budgets-escalated"
  parent: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.override.recorded" }
    target: "dco"
    action: "budgets"
  }
  transitions {
    trigger { event: "dev.getpumi.override.recorded" }
    target: "budgets-escalated"
    action: "escalate"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "implementing"
    action: "resume"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "budgets-escalated"
    action: "escalate"
  }
}

# 7c. DCO: a state that only decides, on entered: every commit has the sign-
# off that the DCO check requires. To outside-checks on the dco gate;
# otherwise retry to implementing; otherwise escalate.
states {
  name: "dco"
  parent: "active"
  gate: "dco"
  wait {}
  transitions {
    trigger { entered {} }
    target: "outside-checks"
    action: "dco"
  }
  transitions {
    trigger { entered {} }
    target: "implementing"
    action: "retry"
  }
  transitions {
    trigger { entered {} }
    target: "dco-escalated"
    action: "escalate"
  }
}

# DCO, escalated: wait for a person (decision 0170). An override goes on to
# outside-checks, decided again by the dco gate, which now reads the override.
# An answer goes back to implementing, decided by resume, which reads the
# usage and the hard caps; the answer goes into the next invocation's input.
# Each trigger ends in escalate, so a denied decision keeps the plan here.
states {
  name: "dco-escalated"
  parent: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.override.recorded" }
    target: "outside-checks"
    action: "dco"
  }
  transitions {
    trigger { event: "dev.getpumi.override.recorded" }
    target: "dco-escalated"
    action: "escalate"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "implementing"
    action: "resume"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "dco-escalated"
    action: "escalate"
  }
}

# 7d. Outside checks: a state that only decides, on entered: every required
# check that Pumi does not run passed on the head commit (decision 0140). To
# report-coverage on the outsideChecks gate; otherwise escalate. A missing
# or pending result is not a pass, so it escalates rather than retrying the
# implementation while the checks run.
states {
  name: "outside-checks"
  parent: "active"
  gate: "outsideChecks"
  wait {}
  transitions {
    trigger { entered {} }
    target: "report-coverage"
    action: "outsideChecks"
  }
  transitions {
    trigger { entered {} }
    target: "outside-checks-escalated"
    action: "escalate"
  }
}

# Outside checks, escalated: wait for a person or for the results. Each
# check.ingested decides the outsideChecks gate again, and the plan goes on to
# report-coverage once the required checks pass. An override goes on the
# same way. An answer goes back to implementing, decided by resume. Each
# trigger ends in escalate, so a denied decision keeps the plan here.
states {
  name: "outside-checks-escalated"
  parent: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.check.ingested" }
    target: "report-coverage"
    action: "outsideChecks"
  }
  transitions {
    trigger { event: "dev.getpumi.check.ingested" }
    target: "outside-checks-escalated"
    action: "escalate"
  }
  transitions {
    trigger { event: "dev.getpumi.override.recorded" }
    target: "report-coverage"
    action: "outsideChecks"
  }
  transitions {
    trigger { event: "dev.getpumi.override.recorded" }
    target: "outside-checks-escalated"
    action: "escalate"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "implementing"
    action: "resume"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "outside-checks-escalated"
    action: "escalate"
  }
}

# 7e. Report coverage (decision 0294): the spec check's program lists each
# requirement that the change adds or modifies, with the test files whose
# Verifies: line names its ID, with the task report-coverage. The kernel
# adds the plan's reasons for having no test and gives the report to the
# conformance audit (decision 0295). To conformance audit on advance;
# otherwise escalate.
states {
  name: "report-coverage"
  parent: "active"
  invoke {
    role: ROLE_GATE
    kind: KIND_CHECK
    component: "spec"
    task: "report-coverage"
    output_message: "pumi.workflow.v1.CoverageReport"
  }
  transitions {
    trigger { result {} }
    target: "conformance-audit"
    action: "advance"
  }
  transitions {
    trigger { result {} }
    target: "report-coverage-escalated"
    action: "escalate"
  }
  transitions {
    trigger { cap_reached {} }
    target: "report-coverage-escalated"
    action: "escalate"
  }
  transitions {
    trigger { failed {} }
    target: "report-coverage"
    action: "retry"
  }
  transitions {
    trigger { failed {} }
    target: "report-coverage-escalated"
    action: "escalate"
  }
}

# Report coverage, escalated: wait for a person. It escalates when the
# report fails or advance is denied. An answer goes back to report-coverage,
# decided by resume, which reads the usage and the hard caps. A denied
# resume keeps the plan here.
states {
  name: "report-coverage-escalated"
  parent: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "report-coverage"
    action: "resume"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "report-coverage-escalated"
    action: "escalate"
  }
}

# 8. Conformance audit (gate role): an independent audit of the tree against
# the change and the plan, with the narratives and the coverage report
# (decisions 0279 and 0280). On the conformance gate, to archiving when the
# project archives after the conformance audit, and to awaiting approval
# otherwise; otherwise retry to implementing; otherwise escalate.
states {
  name: "conformance-audit"
  parent: "active"
  gate: "conformance"
  invoke {
    role: ROLE_GATE
    kind: KIND_HARNESS
    model_role: "auditor"
    task: "audit-conformance"
    output_message: "pumi.events.v1.VerdictRecorded"
    narratives: true
    coverage: true
  }
  transitions {
    trigger { result {} }
    target: "awaiting-approval"
    action: "conformance"
    archive_steps: [ARCHIVE_STEP_AFTER_IMPLEMENTING, ARCHIVE_STEP_OFF]
  }
  transitions {
    trigger { result {} }
    target: "archiving"
    action: "conformance"
    archive_steps: ARCHIVE_STEP_AFTER_CONFORMANCE
  }
  transitions {
    trigger { result {} }
    target: "implementing"
    action: "retry"
  }
  transitions {
    trigger { result {} }
    target: "conformance-audit-escalated"
    action: "escalate"
  }
  transitions {
    trigger { in_doubt {} }
    target: "conformance-audit"
    action: "retry"
  }
  transitions {
    trigger { in_doubt {} }
    target: "conformance-audit-escalated"
    action: "escalate"
  }
  transitions {
    trigger { cap_reached {} }
    target: "conformance-audit-escalated"
    action: "escalate"
  }
  transitions {
    trigger { failed {} }
    target: "conformance-audit"
    action: "retry"
  }
  transitions {
    trigger { failed {} }
    target: "conformance-audit-escalated"
    action: "escalate"
  }
}

# Conformance audit, escalated: wait for a person (decision 0170). An override
# goes on to awaiting-approval, or to archiving when the project archives
# after the conformance audit, decided again by the conformance gate, which
# now reads the override. An answer goes back to implementing, decided by
# resume, which reads the usage and the hard caps; the answer goes into the
# next invocation's input. Each trigger ends in escalate, so a denied decision
# keeps the plan here.
states {
  name: "conformance-audit-escalated"
  parent: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.override.recorded" }
    target: "awaiting-approval"
    action: "conformance"
    archive_steps: [ARCHIVE_STEP_AFTER_IMPLEMENTING, ARCHIVE_STEP_OFF]
  }
  transitions {
    trigger { event: "dev.getpumi.override.recorded" }
    target: "archiving"
    action: "conformance"
    archive_steps: ARCHIVE_STEP_AFTER_CONFORMANCE
  }
  transitions {
    trigger { event: "dev.getpumi.override.recorded" }
    target: "conformance-audit-escalated"
    action: "escalate"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "implementing"
    action: "resume"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "conformance-audit-escalated"
    action: "escalate"
  }
}

# 8a. Archived checking (decision 0278): after the archive step that runs
# after the conformance audit, every check runs again on the archived tree
# before approval, in the archived-* states. The check runs as in checking.
# To archived-scope on advance; otherwise escalate.
states {
  name: "archived-checking"
  parent: "active"
  invoke {
    role: ROLE_GATE
    kind: KIND_CHECK
    component: "checks"
    task: "run-checks"
    output_message: "pumi.workflow.v1.CheckingOutput"
  }
  transitions {
    trigger { result {} }
    target: "archived-scope"
    action: "advance"
  }
  transitions {
    trigger { result {} }
    target: "archived-checking-escalated"
    action: "escalate"
  }
  transitions {
    trigger { cap_reached {} }
    target: "archived-checking-escalated"
    action: "escalate"
  }
  transitions {
    trigger { failed {} }
    target: "archived-checking"
    action: "retry"
  }
  transitions {
    trigger { failed {} }
    target: "archived-checking-escalated"
    action: "escalate"
  }
}

# Archived checking, escalated: wait for a person, as checking-escalated.
# An answer goes back to archived-checking, decided by resume.
states {
  name: "archived-checking-escalated"
  parent: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "archived-checking"
    action: "resume"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "archived-checking-escalated"
    action: "escalate"
  }
}

# 8b. Archived scope: the scope gate on the archived tree. To
# archived-budgets on the scope gate; otherwise retry to implementing;
# otherwise escalate.
states {
  name: "archived-scope"
  parent: "active"
  gate: "scope"
  wait {}
  transitions {
    trigger { entered {} }
    target: "archived-budgets"
    action: "scope"
  }
  transitions {
    trigger { entered {} }
    target: "implementing"
    action: "retry"
  }
  transitions {
    trigger { entered {} }
    target: "archived-scope-escalated"
    action: "escalate"
  }
}

# Archived scope, escalated: as scope-escalated. An override goes on to
# archived-budgets; an answer goes back to implementing.
states {
  name: "archived-scope-escalated"
  parent: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.override.recorded" }
    target: "archived-budgets"
    action: "scope"
  }
  transitions {
    trigger { event: "dev.getpumi.override.recorded" }
    target: "archived-scope-escalated"
    action: "escalate"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "implementing"
    action: "resume"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "archived-scope-escalated"
    action: "escalate"
  }
}

# 8c. Archived budgets: the budgets gate on the archived tree. To
# archived-dco on the budgets gate; otherwise retry to implementing;
# otherwise escalate.
states {
  name: "archived-budgets"
  parent: "active"
  gate: "budgets"
  wait {}
  transitions {
    trigger { entered {} }
    target: "archived-dco"
    action: "budgets"
  }
  transitions {
    trigger { entered {} }
    target: "implementing"
    action: "retry"
  }
  transitions {
    trigger { entered {} }
    target: "archived-budgets-escalated"
    action: "escalate"
  }
}

# Archived budgets, escalated: as budgets-escalated. An override goes on to
# archived-dco; an answer goes back to implementing.
states {
  name: "archived-budgets-escalated"
  parent: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.override.recorded" }
    target: "archived-dco"
    action: "budgets"
  }
  transitions {
    trigger { event: "dev.getpumi.override.recorded" }
    target: "archived-budgets-escalated"
    action: "escalate"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "implementing"
    action: "resume"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "archived-budgets-escalated"
    action: "escalate"
  }
}

# 8d. Archived DCO: the dco gate on the archived tree. To
# archived-outside-checks on the dco gate; otherwise retry to implementing;
# otherwise escalate.
states {
  name: "archived-dco"
  parent: "active"
  gate: "dco"
  wait {}
  transitions {
    trigger { entered {} }
    target: "archived-outside-checks"
    action: "dco"
  }
  transitions {
    trigger { entered {} }
    target: "implementing"
    action: "retry"
  }
  transitions {
    trigger { entered {} }
    target: "archived-dco-escalated"
    action: "escalate"
  }
}

# Archived DCO, escalated: as dco-escalated. An override goes on to
# archived-outside-checks; an answer goes back to implementing.
states {
  name: "archived-dco-escalated"
  parent: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.override.recorded" }
    target: "archived-outside-checks"
    action: "dco"
  }
  transitions {
    trigger { event: "dev.getpumi.override.recorded" }
    target: "archived-dco-escalated"
    action: "escalate"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "implementing"
    action: "resume"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "archived-dco-escalated"
    action: "escalate"
  }
}

# 8e. Archived outside checks: the outsideChecks gate on the archived tree's
# head commit. To awaiting approval on the outsideChecks gate; otherwise
# escalate.
states {
  name: "archived-outside-checks"
  parent: "active"
  gate: "outsideChecks"
  wait {}
  transitions {
    trigger { entered {} }
    target: "awaiting-approval"
    action: "outsideChecks"
  }
  transitions {
    trigger { entered {} }
    target: "archived-outside-checks-escalated"
    action: "escalate"
  }
}

# Archived outside checks, escalated: as outside-checks-escalated. Each
# check.ingested and an override decide the outsideChecks gate again, and
# the plan goes on to awaiting approval; an answer goes back to
# implementing.
states {
  name: "archived-outside-checks-escalated"
  parent: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.check.ingested" }
    target: "awaiting-approval"
    action: "outsideChecks"
  }
  transitions {
    trigger { event: "dev.getpumi.check.ingested" }
    target: "archived-outside-checks-escalated"
    action: "escalate"
  }
  transitions {
    trigger { event: "dev.getpumi.override.recorded" }
    target: "awaiting-approval"
    action: "outsideChecks"
  }
  transitions {
    trigger { event: "dev.getpumi.override.recorded" }
    target: "archived-outside-checks-escalated"
    action: "escalate"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "implementing"
    action: "resume"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "archived-outside-checks-escalated"
    action: "escalate"
  }
}

# 9. Awaiting approval: wait for a person. On approval.recorded: to ready to
# merge on the mergeApproval gate; otherwise, after a rejection, back to
# implementing on resume; otherwise escalate.
states {
  name: "awaiting-approval"
  parent: "active"
  gate: "mergeApproval"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.approval.recorded" }
    target: "ready-to-merge"
    action: "mergeApproval"
  }
  transitions {
    trigger { event: "dev.getpumi.approval.recorded" }
    target: "implementing"
    action: "resume"
  }
  transitions {
    trigger { event: "dev.getpumi.approval.recorded" }
    target: "awaiting-approval-escalated"
    action: "escalate"
  }
}

# Awaiting approval, escalated: wait for a person (decision 0170). An override
# goes on to ready-to-merge, decided again by the mergeApproval gate, which
# now reads the override. An answer goes back to implementing, decided by
# resume, which reads the usage and the hard caps; the answer goes into the
# next invocation's input. Each trigger ends in escalate, so a denied decision
# keeps the plan here.
states {
  name: "awaiting-approval-escalated"
  parent: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.override.recorded" }
    target: "ready-to-merge"
    action: "mergeApproval"
  }
  transitions {
    trigger { event: "dev.getpumi.override.recorded" }
    target: "awaiting-approval-escalated"
    action: "escalate"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "implementing"
    action: "resume"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "awaiting-approval-escalated"
    action: "escalate"
  }
}

# 10. Ready to merge: a state that only decides, on entered. To merging on
# merge, which the invariants guard (decision 0142); otherwise retry to
# implementing, for example when the head is no longer up to date; otherwise
# escalate.
states {
  name: "ready-to-merge"
  parent: "active"
  gate: "merge"
  wait {}
  transitions {
    trigger { entered {} }
    target: "merging"
    action: "merge"
  }
  transitions {
    trigger { entered {} }
    target: "implementing"
    action: "retry"
  }
  transitions {
    trigger { entered {} }
    target: "ready-to-merge-escalated"
    action: "escalate"
  }
}

# Ready to merge, escalated: wait for a person (decision 0170). An override
# goes on to merging, decided again by the merge gate, which now reads the
# override. An answer goes back to implementing, decided by resume, which
# reads the usage and the hard caps; the answer goes into the next
# invocation's input. Each trigger ends in escalate, so a denied decision
# keeps the plan here. An override cannot loosen the invariants that guard
# merge.
states {
  name: "ready-to-merge-escalated"
  parent: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.override.recorded" }
    target: "merging"
    action: "merge"
  }
  transitions {
    trigger { event: "dev.getpumi.override.recorded" }
    target: "ready-to-merge-escalated"
    action: "escalate"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "implementing"
    action: "resume"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "ready-to-merge-escalated"
    action: "escalate"
  }
}

# 11. Merging (external action): the forge adapter merges the approved head
# commit. To merged on advance; otherwise escalate.
states {
  name: "merging"
  parent: "active"
  invoke {
    role: ROLE_AGENT
    kind: KIND_EXTERNAL_ACTION
    task: "merge"
    output_message: "pumi.events.v1.MergePerformed"
  }
  transitions {
    trigger { result {} }
    target: "merged"
    action: "advance"
  }
  transitions {
    trigger { result {} }
    target: "merging-escalated"
    action: "escalate"
  }
  transitions {
    trigger { in_doubt {} }
    target: "merging"
    action: "retry"
  }
  transitions {
    trigger { in_doubt {} }
    target: "merging-escalated"
    action: "escalate"
  }
  transitions {
    trigger { cap_reached {} }
    target: "merging-escalated"
    action: "escalate"
  }
  transitions {
    trigger { failed {} }
    target: "merging"
    action: "retry"
  }
  transitions {
    trigger { failed {} }
    target: "merging-escalated"
    action: "escalate"
  }
}

# Merging, escalated: wait for a person. Merging escalates when the merge
# fails or advance is denied. The answer goes back to ready to merge, so that
# merge is decided again before the forge adapter merges. An answer goes back
# to ready-to-merge, decided by resume, which reads the usage and the hard
# caps; the answer goes into the next invocation's input. A denied resume
# keeps the plan here.
states {
  name: "merging-escalated"
  parent: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "ready-to-merge"
    action: "resume"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "merging-escalated"
    action: "escalate"
  }
}

# 12. Merged: final. The plan's change is on trunk, so a plan that depends
# on it may start (decision 0197).
states {
  name: "merged"
  final { merged: true }
}

# Cancelled: final. A person cancelled the plan.
states {
  name: "cancelled"
  final {}
}
