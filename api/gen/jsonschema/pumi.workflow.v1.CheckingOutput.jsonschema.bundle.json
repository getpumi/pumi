        "^(metrics_adapter_version)$": {
          "default": "",
          "description": "The version of the metrics adapter.",
          "type": "string"
        }
      },
      "properties": {
        "metricsAdapterVersion": {
          "default": "",
          "description": "The version of the metrics adapter.",
          "type": "string"
        },
        "tree": {
          "default": "",
          "description": "The tree.",
          "type": "string"
        },
        "value": {
          "description": "The metric names.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "Budgets Breached",
      "type": "object"
    },
