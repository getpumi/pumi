// The state machine of the first workflow, written by the test
// TestTheGraphIsCurrent with -update, so that a change to the workflow
// shows up as a diff of this graph.
digraph {
	compound=true;
	node [shape=box, style=rounded];
	rankdir="LR";


	legend [shape=none, label="🔄 Reentry\l"];

	init [label="", shape=point];
	init -> spec;

	active [label="active"];
	subgraph cluster_active {
		label="Substates of\nactive";
		style="dashed";
		spec [label="spec"];
		"spec-escalated" [label="spec-escalated"];
		planning [label="planning"];
		"planning-escalated" [label="planning-escalated"];
		"second-opinion" [label="second-opinion"];
		"second-opinion-escalated" [label="second-opinion-escalated"];
		"plan-review" [label="plan-review"];
		"plan-review-escalated" [label="plan-review-escalated"];
		implementing [label="implementing"];
		"implementing-escalated" [label="implementing-escalated"];
		archiving [label="archiving"];
		"archiving-escalated" [label="archiving-escalated"];
		checking [label="checking"];
		"checking-escalated" [label="checking-escalated"];
		scope [label="scope"];
		"scope-escalated" [label="scope-escalated"];
		budgets [label="budgets"];
		"budgets-escalated" [label="budgets-escalated"];
		dco [label="dco"];
		"dco-escalated" [label="dco-escalated"];
		"outside-checks" [label="outside-checks"];
		"outside-checks-escalated" [label="outside-checks-escalated"];
		"report-coverage" [label="report-coverage"];
		"report-coverage-escalated" [label="report-coverage-escalated"];
		"conformance-audit" [label="conformance-audit"];
		"conformance-audit-escalated" [label="conformance-audit-escalated"];
		"archived-checking" [label="archived-checking"];
		"archived-checking-escalated" [label="archived-checking-escalated"];
		"archived-scope" [label="archived-scope"];
		"archived-scope-escalated" [label="archived-scope-escalated"];
		"archived-budgets" [label="archived-budgets"];
		"archived-budgets-escalated" [label="archived-budgets-escalated"];
		"archived-dco" [label="archived-dco"];
		"archived-dco-escalated" [label="archived-dco-escalated"];
		"archived-outside-checks" [label="archived-outside-checks"];
		"archived-outside-checks-escalated" [label="archived-outside-checks-escalated"];
		"awaiting-approval" [label="awaiting-approval"];
		"awaiting-approval-escalated" [label="awaiting-approval-escalated"];
		"ready-to-merge" [label="ready-to-merge"];
		"ready-to-merge-escalated" [label="ready-to-merge-escalated"];
		merging [label="merging"];
		"merging-escalated" [label="merging-escalated"];
	}
	cancelled [label="cancelled"];
	merged [label="merged"];
	active -> cancelled [label="cancel.requested / cancel"];
	"archived-budgets" -> "archived-dco" [label="entered / budgets"];
	"archived-budgets" -> "archived-budgets-escalated" [label="entered / escalate"];
	"archived-budgets" -> implementing [label="entered / retry"];
	"archived-budgets-escalated" -> "archived-budgets-escalated" [label="🔄 escalation.resolved / escalate\l🔄 override.recorded / escalate\l"];
	"archived-budgets-escalated" -> implementing [label="escalation.resolved / resume"];
	"archived-budgets-escalated" -> "archived-dco" [label="override.recorded / budgets"];
	"archived-checking" -> "archived-checking-escalated" [label="cap-reached / escalate\lfailed / escalate\lresult / escalate\l"];
	"archived-checking" -> "archived-checking" [label="🔄 failed / retry"];
	"archived-checking" -> "archived-scope" [label="result / advance"];
	"archived-checking-escalated" -> "archived-checking-escalated" [label="🔄 escalation.resolved / escalate"];
	"archived-checking-escalated" -> "archived-checking" [label="escalation.resolved / resume"];
	"archived-dco" -> "archived-outside-checks" [label="entered / dco"];
	"archived-dco" -> "archived-dco-escalated" [label="entered / escalate"];
	"archived-dco" -> implementing [label="entered / retry"];
	"archived-dco-escalated" -> "archived-dco-escalated" [label="🔄 escalation.resolved / escalate\l🔄 override.recorded / escalate\l"];
	"archived-dco-escalated" -> implementing [label="escalation.resolved / resume"];
	"archived-dco-escalated" -> "archived-outside-checks" [label="override.recorded / dco"];
	"archived-outside-checks" -> "archived-outside-checks-escalated" [label="entered / escalate"];
	"archived-outside-checks" -> "awaiting-approval" [label="entered / outsideChecks"];
	"archived-outside-checks-escalated" -> "archived-outside-checks-escalated" [label="🔄 check.ingested / escalate\l🔄 escalation.resolved / escalate\l🔄 override.recorded / escalate\l"];
	"archived-outside-checks-escalated" -> "awaiting-approval" [label="check.ingested / outsideChecks\loverride.recorded / outsideChecks\l"];
	"archived-outside-checks-escalated" -> implementing [label="escalation.resolved / resume"];
	"archived-scope" -> "archived-scope-escalated" [label="entered / escalate"];
	"archived-scope" -> implementing [label="entered / retry"];
	"archived-scope" -> "archived-budgets" [label="entered / scope"];
	"archived-scope-escalated" -> "archived-scope-escalated" [label="🔄 escalation.resolved / escalate\l🔄 override.recorded / escalate\l"];
	"archived-scope-escalated" -> implementing [label="escalation.resolved / resume"];
	"archived-scope-escalated" -> "archived-budgets" [label="override.recorded / scope"];
	archiving -> "archiving-escalated" [label="cap-reached / escalate\lfailed / escalate\lresult / escalate\l"];
	archiving -> archiving [label="🔄 failed / retry"];
	archiving -> "archived-checking" [label="result / advance [after_conformance]"];
	archiving -> checking [label="result / advance [after_implementing]"];
	"archiving-escalated" -> "archiving-escalated" [label="🔄 escalation.resolved / escalate"];
	"archiving-escalated" -> archiving [label="escalation.resolved / resume"];
	"awaiting-approval" -> "awaiting-approval-escalated" [label="approval.recorded / escalate"];
	"awaiting-approval" -> "ready-to-merge" [label="approval.recorded / mergeApproval"];
	"awaiting-approval" -> implementing [label="approval.recorded / resume"];
	"awaiting-approval-escalated" -> "awaiting-approval-escalated" [label="🔄 escalation.resolved / escalate\l🔄 override.recorded / escalate\l"];
	"awaiting-approval-escalated" -> implementing [label="escalation.resolved / resume"];
	"awaiting-approval-escalated" -> "ready-to-merge" [label="override.recorded / mergeApproval"];
	budgets -> dco [label="entered / budgets"];
	budgets -> "budgets-escalated" [label="entered / escalate"];
	budgets -> implementing [label="entered / retry"];
	"budgets-escalated" -> "budgets-escalated" [label="🔄 escalation.resolved / escalate\l🔄 override.recorded / escalate\l"];
	"budgets-escalated" -> implementing [label="escalation.resolved / resume"];
	"budgets-escalated" -> dco [label="override.recorded / budgets"];
	checking -> "checking-escalated" [label="cap-reached / escalate\lfailed / escalate\lresult / escalate\l"];
	checking -> checking [label="🔄 failed / retry"];
	checking -> scope [label="result / advance"];
	"checking-escalated" -> "checking-escalated" [label="🔄 escalation.resolved / escalate"];
	"checking-escalated" -> checking [label="escalation.resolved / resume"];
	"conformance-audit" -> "conformance-audit-escalated" [label="cap-reached / escalate\lfailed / escalate\lin-doubt / escalate\lresult / escalate\l"];
	"conformance-audit" -> "conformance-audit" [label="🔄 failed / retry\l🔄 in-doubt / retry\l"];
	"conformance-audit" -> archiving [label="result / conformance [after_conformance]"];
	"conformance-audit" -> "awaiting-approval" [label="result / conformance [after_implementing, off]"];
	"conformance-audit" -> implementing [label="result / retry"];
	"conformance-audit-escalated" -> "conformance-audit-escalated" [label="🔄 escalation.resolved / escalate\l🔄 override.recorded / escalate\l"];
	"conformance-audit-escalated" -> implementing [label="escalation.resolved / resume"];
	"conformance-audit-escalated" -> archiving [label="override.recorded / conformance [after_conformance]"];
	"conformance-audit-escalated" -> "awaiting-approval" [label="override.recorded / conformance [after_implementing, off]"];
	dco -> "outside-checks" [label="entered / dco"];
	dco -> "dco-escalated" [label="entered / escalate"];
	dco -> implementing [label="entered / retry"];
	"dco-escalated" -> "dco-escalated" [label="🔄 escalation.resolved / escalate\l🔄 override.recorded / escalate\l"];
	"dco-escalated" -> implementing [label="escalation.resolved / resume"];
	"dco-escalated" -> "outside-checks" [label="override.recorded / dco"];
	implementing -> "implementing-escalated" [label="cap-reached / escalate\lfailed / escalate\lin-doubt / escalate\lresult / escalate\l"];
	implementing -> implementing [label="🔄 failed / retry\l🔄 in-doubt / retry\l"];
	implementing -> checking [label="result / advance [after_conformance, off]"];
	implementing -> archiving [label="result / advance [after_implementing]"];
	"implementing-escalated" -> "implementing-escalated" [label="🔄 escalation.resolved / escalate"];
	"implementing-escalated" -> implementing [label="escalation.resolved / resume"];
	merging -> "merging-escalated" [label="cap-reached / escalate\lfailed / escalate\lin-doubt / escalate\lresult / escalate\l"];
	merging -> merging [label="🔄 failed / retry\l🔄 in-doubt / retry\l"];
	merging -> merged [label="result / advance"];
	"merging-escalated" -> "merging-escalated" [label="🔄 escalation.resolved / escalate"];
	"merging-escalated" -> "ready-to-merge" [label="escalation.resolved / resume"];
	"outside-checks" -> "outside-checks-escalated" [label="entered / escalate"];
	"outside-checks" -> "report-coverage" [label="entered / outsideChecks"];
	"outside-checks-escalated" -> "outside-checks-escalated" [label="🔄 check.ingested / escalate\l🔄 escalation.resolved / escalate\l🔄 override.recorded / escalate\l"];
	"outside-checks-escalated" -> "report-coverage" [label="check.ingested / outsideChecks\loverride.recorded / outsideChecks\l"];
	"outside-checks-escalated" -> implementing [label="escalation.resolved / resume"];
	"plan-review" -> "plan-review-escalated" [label="cap-reached / escalate\lfailed / escalate\lin-doubt / escalate\lresult / escalate\l"];
	"plan-review" -> "plan-review" [label="🔄 failed / retry\l🔄 in-doubt / retry\l"];
	"plan-review" -> implementing [label="result / planReview"];
	"plan-review" -> planning [label="result / retry"];
	"plan-review-escalated" -> "plan-review-escalated" [label="🔄 escalation.resolved / escalate\l🔄 override.recorded / escalate\l"];
	"plan-review-escalated" -> planning [label="escalation.resolved / resume"];
	"plan-review-escalated" -> implementing [label="override.recorded / planReview"];
	planning -> "planning-escalated" [label="cap-reached / escalate\lfailed / escalate\lin-doubt / escalate\lresult / escalate\l"];
	planning -> planning [label="🔄 failed / retry\l🔄 in-doubt / retry\l"];
	planning -> "plan-review" [label="result / advance"];
	planning -> "second-opinion" [label="result / ask"];
	"planning-escalated" -> "planning-escalated" [label="🔄 escalation.resolved / escalate"];
	"planning-escalated" -> planning [label="escalation.resolved / resume"];
	"ready-to-merge" -> "ready-to-merge-escalated" [label="entered / escalate"];
	"ready-to-merge" -> merging [label="entered / merge"];
	"ready-to-merge" -> implementing [label="entered / retry"];
	"ready-to-merge-escalated" -> "ready-to-merge-escalated" [label="🔄 escalation.resolved / escalate\l🔄 override.recorded / escalate\l"];
	"ready-to-merge-escalated" -> implementing [label="escalation.resolved / resume"];
	"ready-to-merge-escalated" -> merging [label="override.recorded / merge"];
	"report-coverage" -> "report-coverage-escalated" [label="cap-reached / escalate\lfailed / escalate\lresult / escalate\l"];
	"report-coverage" -> "report-coverage" [label="🔄 failed / retry"];
	"report-coverage" -> "conformance-audit" [label="result / advance"];
	"report-coverage-escalated" -> "report-coverage-escalated" [label="🔄 escalation.resolved / escalate"];
	"report-coverage-escalated" -> "report-coverage" [label="escalation.resolved / resume"];
	scope -> "scope-escalated" [label="entered / escalate"];
	scope -> implementing [label="entered / retry"];
	scope -> budgets [label="entered / scope"];
	"scope-escalated" -> "scope-escalated" [label="🔄 escalation.resolved / escalate\l🔄 override.recorded / escalate\l"];
	"scope-escalated" -> implementing [label="escalation.resolved / resume"];
	"scope-escalated" -> budgets [label="override.recorded / scope"];
	"second-opinion" -> "second-opinion-escalated" [label="cap-reached / escalate\lfailed / escalate\lin-doubt / escalate\lresult / escalate\l"];
	"second-opinion" -> "second-opinion" [label="🔄 failed / retry\l🔄 in-doubt / retry\l"];
	"second-opinion" -> planning [label="result / ambiguity"];
	"second-opinion-escalated" -> "second-opinion-escalated" [label="🔄 escalation.resolved / escalate\l🔄 override.recorded / escalate\l"];
	"second-opinion-escalated" -> planning [label="escalation.resolved / resume\loverride.recorded / ambiguity\l"];
	spec -> "spec-escalated" [label="cap-reached / escalate\lfailed / escalate\lresult / escalate\l"];
	spec -> spec [label="🔄 failed / retry"];
	spec -> planning [label="result / spec"];
	"spec-escalated" -> "spec-escalated" [label="🔄 escalation.resolved / escalate\l🔄 override.recorded / escalate\l"];
	"spec-escalated" -> spec [label="escalation.resolved / resume"];
	"spec-escalated" -> planning [label="override.recorded / spec"];
}
