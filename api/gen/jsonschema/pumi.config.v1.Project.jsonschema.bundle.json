{
  "$defs": {
    "pumi.config.v1.Project.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Project is the project of the Cedar resource Plan (decision 0141), and the\n project section that the kernel adds to the task of every agent run\n (decision 0250). It is apart from the model configuration.",
      "patternProperties": {
        "^(archive_step)$": {
          "anyOf": [
            {
              "pattern": "^ARCHIVE_STEP_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "ARCHIVE_STEP_AFTER_IMPLEMENTING",
                "ARCHIVE_STEP_AFTER_CONFORMANCE",
                "ARCHIVE_STEP_OFF"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "description": "Where the change is archived.",
          "title": "Archive Step"
        },
        "^(check_commands)$": {
          "description": "The commands that run the project's checks, such as make test.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "^(convention_files)$": {
          "description": "The files that hold the project's conventions, such as AGENTS.md,\n relative to the root of the repository. The task names a file that the\n input tree does not hold as missing.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "^(protected_paths)$": {
          "description": "The project's protected path patterns.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "properties": {
        "archiveStep": {
          "anyOf": [
            {
              "pattern": "^ARCHIVE_STEP_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "ARCHIVE_STEP_AFTER_IMPLEMENTING",
                "ARCHIVE_STEP_AFTER_CONFORMANCE",
                "ARCHIVE_STEP_OFF"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "description": "Where the change is archived.",
          "title": "Archive Step"
        },
        "checkCommands": {
          "description": "The commands that run the project's checks, such as make test.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "conventionFiles": {
          "description": "The files that hold the project's conventions, such as AGENTS.md,\n relative to the root of the repository. The task names a file that the\n input tree does not hold as missing.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "default": "",
          "description": "The project's name.",
          "type": "string"
        },
        "protectedPaths": {
          "description": "The project's protected path patterns.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "Project",
      "type": "object"
    }
  },
  "$id": "pumi.config.v1.Project.jsonschema.bundle.json",
  "$ref": "#/$defs/pumi.config.v1.Project.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
