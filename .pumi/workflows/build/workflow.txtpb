# The workflow of Pumi's own runs until epic E10's gates run (decision
# 0293): the first workflow's spec, planning, implementing and archive
# states, each with its escalated state, and then the end. The pull
# request's CI and Michael's review take the place of the checking, gate,
# conformance audit and approval states (decision 0065). Nothing merges
# here, so neither final state marks the plan merged (decision 0197).
#
# The task of an agent run is the text file <task>.md beside this file,
# copied from the first workflow; the task of a check is its task id
# (decision 0297).
#
# The archive step of the project places the archive state (decisions 0278
# and 0296). With no audit and no checks here, archiving is the last state
# under both after implementing and after the conformance audit; with the
# archive step off, the plan ends after implementing.
name: "pumi-build"
version: "1"
initial: "spec"

# The superstate that holds every state of a plan that is not finished. A
# cancel.requested for the plan goes to cancelled from any of them.
states {
  name: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.cancel.requested" }
    target: "cancelled"
    action: "cancel"
  }
}

# Spec (initial): the OpenSpec adapter validates the plan's change. To
# planning on the spec gate; otherwise escalate.
states {
  name: "spec"
  parent: "active"
  gate: "spec"
  invoke {
    role: ROLE_GATE
    kind: KIND_CHECK
    component: "spec"
    task: "validate-spec"
    output_message: "pumi.workflow.v1.SpecCheckOutput"
  }
  transitions {
    trigger { result {} }
    target: "planning"
    action: "spec"
  }
  transitions {
    trigger { result {} }
    target: "spec-escalated"
    action: "escalate"
  }
  transitions {
    trigger { cap_reached {} }
    target: "spec-escalated"
    action: "escalate"
  }
  transitions {
    trigger { failed {} }
    target: "spec"
    action: "retry"
  }
  transitions {
    trigger { failed {} }
    target: "spec-escalated"
    action: "escalate"
  }
}

# Spec, escalated: wait for a person. An override goes on to planning,
# decided again by the spec gate; an answer goes back to spec, decided by
# resume.
states {
  name: "spec-escalated"
  parent: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.override.recorded" }
    target: "planning"
    action: "spec"
  }
  transitions {
    trigger { event: "dev.getpumi.override.recorded" }
    target: "spec-escalated"
    action: "escalate"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "spec"
    action: "resume"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "spec-escalated"
    action: "escalate"
  }
}

# Planning: an agent writes the plan, with its declared paths and any open
# questions, each with the agent's own answer. With open questions, to
# planning-escalated on ask, which is allowed only when questions.open is
# above zero, so that a person answers them, since this workflow has no
# second opinion (decision 0310); otherwise to implementing on advance;
# otherwise escalate.
states {
  name: "planning"
  parent: "active"
  invoke {
    role: ROLE_AGENT
    kind: KIND_HARNESS
    model_role: "planner"
    task: "plan"
    output_message: "pumi.workflow.v1.PlanningOutput"
  }
  transitions {
    trigger { result {} }
    target: "planning-escalated"
    action: "ask"
  }
  transitions {
    trigger { result {} }
    target: "implementing"
    action: "advance"
  }
  transitions {
    trigger { result {} }
    target: "planning-escalated"
    action: "escalate"
  }
  transitions {
    trigger { in_doubt {} }
    target: "planning"
    action: "retry"
  }
  transitions {
    trigger { in_doubt {} }
    target: "planning-escalated"
    action: "escalate"
  }
  transitions {
    trigger { cap_reached {} }
    target: "planning-escalated"
    action: "escalate"
  }
  transitions {
    trigger { failed {} }
    target: "planning"
    action: "retry"
  }
  transitions {
    trigger { failed {} }
    target: "planning-escalated"
    action: "escalate"
  }
}

# Planning, escalated: wait for a person, who answers the open questions or
# resolves what stopped planning. An answer goes back to planning, decided
# by resume; the answer goes into the next invocation's input.
states {
  name: "planning-escalated"
  parent: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "planning"
    action: "resume"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "planning-escalated"
    action: "escalate"
  }
}

# Implementing: an agent makes the change in the workspace. To archiving on
# advance, or to done when the archive step is off; otherwise escalate.
states {
  name: "implementing"
  parent: "active"
  invoke {
    role: ROLE_AGENT
    kind: KIND_HARNESS
    model_role: "implementer"
    task: "implement"
    output_message: "pumi.workflow.v1.ImplementationOutput"
  }
  transitions {
    trigger { result {} }
    target: "archiving"
    action: "advance"
    archive_steps: [ARCHIVE_STEP_AFTER_IMPLEMENTING, ARCHIVE_STEP_AFTER_CONFORMANCE]
  }
  transitions {
    trigger { result {} }
    target: "done"
    action: "advance"
    archive_steps: ARCHIVE_STEP_OFF
  }
  transitions {
    trigger { result {} }
    target: "implementing-escalated"
    action: "escalate"
  }
  transitions {
    trigger { in_doubt {} }
    target: "implementing"
    action: "retry"
  }
  transitions {
    trigger { in_doubt {} }
    target: "implementing-escalated"
    action: "escalate"
  }
  transitions {
    trigger { cap_reached {} }
    target: "implementing-escalated"
    action: "escalate"
  }
  transitions {
    trigger { failed {} }
    target: "implementing"
    action: "retry"
  }
  transitions {
    trigger { failed {} }
    target: "implementing-escalated"
    action: "escalate"
  }
}

# Implementing, escalated: wait for a person. An answer goes back to
# implementing, decided by resume.
states {
  name: "implementing-escalated"
  parent: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "implementing"
    action: "resume"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "implementing-escalated"
    action: "escalate"
  }
}

# Archiving (decision 0278): the spec check's program archives the plan's
# change in the workspace, or on a later round checks the archive against
# the base tree (decision 0285). Its result carries the workspace's tree
# (decision 0282). To done on advance; otherwise escalate.
states {
  name: "archiving"
  parent: "active"
  invoke {
    role: ROLE_GATE
    kind: KIND_CHECK
    component: "spec"
    task: "archive-change"
    returns_tree: true
  }
  transitions {
    trigger { result {} }
    target: "done"
    action: "advance"
  }
  transitions {
    trigger { result {} }
    target: "archiving-escalated"
    action: "escalate"
  }
  transitions {
    trigger { cap_reached {} }
    target: "archiving-escalated"
    action: "escalate"
  }
  transitions {
    trigger { failed {} }
    target: "archiving"
    action: "retry"
  }
  transitions {
    trigger { failed {} }
    target: "archiving-escalated"
    action: "escalate"
  }
}

# Archiving, escalated: wait for a person. An answer goes back to
# archiving, decided by resume.
states {
  name: "archiving-escalated"
  parent: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "archiving"
    action: "resume"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "archiving-escalated"
    action: "escalate"
  }
}

# Done: final. The tree goes to a branch and a pull request, which a
# person merges.
states {
  name: "done"
  final {}
}

# Cancelled: final.
states {
  name: "cancelled"
  final {}
}
