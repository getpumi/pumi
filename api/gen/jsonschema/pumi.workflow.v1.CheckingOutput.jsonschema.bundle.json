        },
        "pathsProtected": {
          "$ref": "#/$defs/pumi.facts.v1.PathsProtected.jsonschema.json",
          "description": "paths.protected."
        },
        "verifyPassed": {
          "$ref": "#/$defs/pumi.facts.v1.VerifyPassed.jsonschema.json",
          "description": "verify.passed."
        }
      },
      "title": "Checking Output",
      "type": "object"
    }
