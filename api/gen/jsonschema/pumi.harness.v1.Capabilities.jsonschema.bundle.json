{
  "$defs": {
    "pumi.harness.v1.Capabilities.Network.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Network is the network access of a run.",
      "properties": {
        "access": {
          "anyOf": [
            {
              "pattern": "^ACCESS_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "ACCESS_NONE",
                "ACCESS_GATEWAY",
                "ACCESS_HOSTS"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "description": "The access.",
          "title": "Access"
        },
        "hosts": {
          "description": "The hosts, when the access is ACCESS_HOSTS.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "Network",
      "type": "object"
    },
    "pumi.harness.v1.Capabilities.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Capabilities is the capability list of an invocation (decision 0159),\n neutral between harnesses. What the list leaves out, the run may not do.",
      "patternProperties": {
        "^(write_paths)$": {
          "description": "The paths the run may write, as globs relative to the workspace. A file\n written outside them fails the invocation.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "properties": {
        "commands": {
          "description": "The commands the run may run, as prefixes such as \"go test\".",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "network": {
          "$ref": "#/$defs/pumi.harness.v1.Capabilities.Network.jsonschema.json",
          "description": "The network access."
        },
        "tools": {
          "description": "The kinds of tool the run may use.",
          "items": {
            "anyOf": [
              {
                "enum": [
                  "TOOL_KIND_UNSPECIFIED",
                  "TOOL_KIND_READ",
                  "TOOL_KIND_EDIT",
                  "TOOL_KIND_RUN_COMMANDS",
                  "TOOL_KIND_WEB"
                ],
                "type": "string"
              },
              {
                "maximum": 2147483647,
                "minimum": -2147483648,
                "type": "integer"
              }
            ],
            "title": "Tool Kind"
          },
          "type": "array"
        },
        "writePaths": {
          "description": "The paths the run may write, as globs relative to the workspace. A file\n written outside them fails the invocation.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "Capabilities",
      "type": "object"
    }
  },
  "$id": "pumi.harness.v1.Capabilities.jsonschema.bundle.json",
  "$ref": "#/$defs/pumi.harness.v1.Capabilities.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
