{
  "$defs": {
    "pumi.events.v1.LeaseExpired.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "LeaseExpired is the data of dev.getpumi.lease.expired: the holder did not\n renew the lease in time.",
      "properties": {
        "lease": {
          "default": "",
          "description": "The lease.",
          "type": "string"
        },
        "number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "The lease number."
        }
      },
      "title": "Lease Expired",
      "type": "object"
    }
  },
  "$id": "pumi.events.v1.LeaseExpired.jsonschema.bundle.json",
  "$ref": "#/$defs/pumi.events.v1.LeaseExpired.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
