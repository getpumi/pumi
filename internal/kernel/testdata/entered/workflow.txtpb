# A workflow with a state that only decides, for the golden case of the
# entered trigger (decision 0170): implementing goes on advance to
# reviewing, which decides advance again as it is entered and goes to done.
# It is test data, not a workflow of the release (decision 0166).
name: "entered"
version: "1"
initial: "implementing"

# The superstate of the states of a plan that is not finished. A
# cancel.requested for the plan goes to cancelled, guarded by cancel.
states {
  name: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.cancel.requested" }
    target: "cancelled"
    action: "cancel"
  }
}

# Implementing (initial): an agent implements the plan. To reviewing on
# advance; otherwise escalate.
states {
  name: "implementing"
  parent: "active"
  invoke {
    role: ROLE_AGENT
    kind: KIND_HARNESS
    task: "implement"
    output_message: "pumi.workflow.v1.ImplementationOutput"
  }
  transitions {
    trigger { result {} }
    target: "reviewing"
    action: "advance"
  }
  transitions {
    trigger { result {} }
    target: "escalated"
    action: "escalate"
  }
}

# Reviewing: starts nothing and decides as it is entered. To done on
# advance; otherwise escalate.
states {
  name: "reviewing"
  parent: "active"
  wait {}
  transitions {
    trigger { entered {} }
    target: "done"
    action: "advance"
  }
  transitions {
    trigger { entered {} }
    target: "escalated"
    action: "escalate"
  }
}

# Escalated: wait for a person. An answer goes back to implementing, decided
# by resume. A denied resume keeps the plan here.
states {
  name: "escalated"
  parent: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "implementing"
    action: "resume"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "escalated"
    action: "escalate"
  }
}

# The plan is implemented.
states {
  name: "done"
  final {}
}

# The plan was cancelled.
states {
  name: "cancelled"
  final {}
}
