# The workflow of the spike (decision 0181): one agent state, implementing,
# that goes to the final state done on advance. advance is permitted for the
# kernel by core.workflow-actions and forbidden over the hard caps by
# invariant.caps; otherwise the plan escalates. The golden cases of cmd/pumi
# run on it (decision 0183), and so does the real run of an archived plan
# (decision 0186). It is test data, not a workflow of the release (decision
# 0166).
name: "spike"
version: "1"
initial: "implementing"

# The superstate of the states of a plan that is not finished. A
# cancel.requested for the plan goes to cancelled, guarded by cancel (decisions
# 0170 and 0177).
states {
  name: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.cancel.requested" }
    target: "cancelled"
    action: "cancel"
  }
}

# Implementing (initial): an agent implements the plan. To done on advance;
# otherwise escalate.
# When its invocation is in doubt, it runs again on retry, which the
# in-doubt attempts and the hard caps guard; otherwise it escalates
# (decisions 0200 and 0201). When its invocation reaches its wall-time limit,
# it escalates (decision 0203).
states {
  name: "implementing"
  parent: "active"
  invoke {
    role: ROLE_AGENT
    kind: KIND_HARNESS
    task: "implement"
    output_message: "pumi.workflow.v1.ImplementationOutput"
  }
  transitions {
    trigger { result {} }
    target: "done"
    action: "advance"
  }
  transitions {
    trigger { result {} }
    target: "implementing-escalated"
    action: "escalate"
  }
  transitions {
    trigger { in_doubt {} }
    target: "implementing"
    action: "retry"
  }
  transitions {
    trigger { in_doubt {} }
    target: "implementing-escalated"
    action: "escalate"
  }
  transitions {
    trigger { cap_reached {} }
    target: "implementing-escalated"
    action: "escalate"
  }
}

# Implementing, escalated: wait for a person. An answer goes back to
# implementing, decided by resume, which reads the usage and the hard caps. A
# denied resume keeps the plan here.
states {
  name: "implementing-escalated"
  parent: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "implementing"
    action: "resume"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "implementing-escalated"
    action: "escalate"
  }
}

# The plan is implemented.
states {
  name: "done"
  final {}
}

# The plan was cancelled.
states {
  name: "cancelled"
  final {}
}
