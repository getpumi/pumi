{
  "$defs": {
    "google.protobuf.Any.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "title": "Any",
      "type": "object"
    },
    "google.protobuf.Timestamp.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "io.cloudevents.v1.CloudEvent.CloudEventAttributeValue.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(ce_boolean)$": {
          "type": "boolean"
        },
        "^(ce_bytes)$": {
          "pattern": "^[A-Za-z0-9+/]*={0,2}$",
          "type": "string"
        },
        "^(ce_integer)$": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ]
        },
        "^(ce_string)$": {
          "type": "string"
        },
        "^(ce_timestamp)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        },
        "^(ce_uri)$": {
          "type": "string"
        },
        "^(ce_uri_ref)$": {
          "type": "string"
        }
      },
      "properties": {
        "ceBoolean": {
          "type": "boolean"
        },
        "ceBytes": {
          "pattern": "^[A-Za-z0-9+/]*={0,2}$",
          "type": "string"
        },
        "ceInteger": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ]
        },
        "ceString": {
          "type": "string"
        },
        "ceTimestamp": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        },
        "ceUri": {
          "type": "string"
        },
        "ceUriRef": {
          "type": "string"
        }
      },
      "title": "Cloud Event Attribute Value",
      "type": "object"
    },
    "io.cloudevents.v1.CloudEvent.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(binary_data)$": {
          "pattern": "^[A-Za-z0-9+/]*={0,2}$",
          "type": "string"
        },
        "^(proto_data)$": {
          "$ref": "#/$defs/google.protobuf.Any.jsonschema.json"
        },
        "^(spec_version)$": {
          "default": "",
          "type": "string"
        },
        "^(text_data)$": {
          "type": "string"
        }
      },
      "properties": {
        "attributes": {
          "additionalProperties": {
            "$ref": "#/$defs/io.cloudevents.v1.CloudEvent.CloudEventAttributeValue.jsonschema.json"
          },
          "description": "Optional \u0026 Extension Attributes",
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "binaryData": {
          "pattern": "^[A-Za-z0-9+/]*={0,2}$",
          "type": "string"
        },
        "id": {
          "default": "",
          "description": "Required Attributes",
          "type": "string"
        },
        "protoData": {
          "$ref": "#/$defs/google.protobuf.Any.jsonschema.json"
        },
        "source": {
          "default": "",
          "type": "string"
        },
        "specVersion": {
          "default": "",
          "type": "string"
        },
        "textData": {
          "type": "string"
        },
        "type": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Cloud Event",
      "type": "object"
    },
    "pumi.events.v1.InvocationResult.OutputFile.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "OutputFile is one output file, stored as a blob.",
      "patternProperties": {
        "^(blob_hash)$": {
          "default": "",
          "description": "The hash of the blob that holds it.",
          "type": "string"
        }
      },
      "properties": {
        "blobHash": {
          "default": "",
          "description": "The hash of the blob that holds it.",
          "type": "string"
        },
        "path": {
          "default": "",
          "description": "The path of the file.",
          "type": "string"
        }
      },
      "title": "Output File",
      "type": "object"
    },
    "pumi.events.v1.InvocationResult.Usage.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Usage is the usage summary of the invocation.",
      "patternProperties": {
        "^(cost_microdollars)$": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "The cost in microdollars (decision 0136)."
        }
      },
      "properties": {
        "costMicrodollars": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "The cost in microdollars (decision 0136)."
        },
        "seconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "The seconds the invocation ran."
        },
        "tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "The tokens used."
        }
      },
      "title": "Usage",
      "type": "object"
    },
    "pumi.events.v1.InvocationResult.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "InvocationResult is the data of dev.getpumi.invocation.result: what the\n invocation produced.",
      "patternProperties": {
        "^(log_blob_hash)$": {
          "default": "",
          "description": "The hash of the blob that holds the full log (decision 0034).",
          "type": "string"
        },
        "^(output_files)$": {
          "description": "The output files.",
          "items": {
            "$ref": "#/$defs/pumi.events.v1.InvocationResult.OutputFile.jsonschema.json"
          },
          "type": "array"
        }
      },
      "properties": {
        "invocation": {
          "default": "",
          "description": "The invocation.",
          "type": "string"
        },
        "logBlobHash": {
          "default": "",
          "description": "The hash of the blob that holds the full log (decision 0034).",
          "type": "string"
        },
        "output": {
          "default": "",
          "description": "The structured output, as the protojson of the message that the\n invocation document names, as the runner parsed it (decisions 0160 and\n 0162).",
          "type": "string"
        },
        "outputFiles": {
          "description": "The output files.",
          "items": {
            "$ref": "#/$defs/pumi.events.v1.InvocationResult.OutputFile.jsonschema.json"
          },
          "type": "array"
        },
        "refusals": {
          "description": "The refusals that the harness reported, from the adapter's result\n (decision 0249).",
          "items": {
            "$ref": "#/$defs/pumi.harness.v1.Refusal.jsonschema.json"
          },
          "type": "array"
        },
        "tree": {
          "default": "",
          "description": "The tree that the runner computed from the workspace after the adapter\n exited; empty when the invocation changes no code (decisions 0160 and\n 0162).",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/pumi.events.v1.InvocationResult.Usage.jsonschema.json",
          "description": "The usage summary."
        }
      },
      "title": "Invocation Result",
      "type": "object"
    },
    "pumi.harness.v1.Refusal.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Refusal is one thing that the run asked to do and its harness refused\n (decision 0249).",
      "properties": {
        "command": {
          "description": "The command that the run asked to run, as the harness reported it.",
          "type": "string"
        },
        "host": {
          "description": "The host that the run asked to reach.",
          "type": "string"
        },
        "path": {
          "description": "The path, relative to the workspace or absolute, that the run asked\n to read or write.",
          "type": "string"
        },
        "tool": {
          "anyOf": [
            {
              "pattern": "^TOOL_KIND_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "TOOL_KIND_READ",
                "TOOL_KIND_EDIT",
                "TOOL_KIND_RUN_COMMANDS",
                "TOOL_KIND_WEB"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "description": "The kind of tool that asked.",
          "title": "Tool Kind"
        }
      },
      "title": "Refusal",
      "type": "object"
    },
    "pumi.runner.v1.ReportRequest.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "ReportRequest is the request of Report.",
      "patternProperties": {
        "^(lease_number)$": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "The lease number from Claim."
        }
      },
      "properties": {
        "events": {
          "description": "The other events the invocation produced, written between\n invocation.result and invocation.finished. The invocation decides which\n types are allowed: a gate-role invocation may report verdict.recorded\n and warning.raised, an external-action invocation merge.performed,\n check.ingested and trunk.unattested, and an agent-role invocation\n only dev.getpumi.model_role.switched, when a limit switched its model\n role to its fallback (decisions 0156 and 0246).",
          "items": {
            "$ref": "#/$defs/io.cloudevents.v1.CloudEvent.jsonschema.json"
          },
          "type": "array"
        },
        "invocation": {
          "default": "",
          "description": "The invocation.",
          "type": "string"
        },
        "leaseNumber": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "The lease number from Claim."
        },
        "outcome": {
          "anyOf": [
            {
              "pattern": "^OUTCOME_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "OUTCOME_SUCCEEDED",
                "OUTCOME_FAILED",
                "OUTCOME_CANCELLED",
                "OUTCOME_CAP_REACHED",
                "OUTCOME_RESOLVED_ON_RECOVERY"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "description": "The outcome, appended as invocation.finished.",
          "title": "Outcome"
        },
        "result": {
          "$ref": "#/$defs/pumi.events.v1.InvocationResult.jsonschema.json",
          "description": "The result, appended as invocation.result."
        }
      },
      "title": "Report Request",
      "type": "object"
    }
  },
  "$id": "pumi.runner.v1.ReportRequest.jsonschema.bundle.json",
  "$ref": "#/$defs/pumi.runner.v1.ReportRequest.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
