{
  "$defs": {
    "pumi.facts.v1.WarningsOpen.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "WarningsOpen is warnings.open: the warnings of the project not yet\n reviewed.",
      "properties": {
        "project": {
          "default": "",
          "description": "The project.",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "The number of open warnings."
        }
      },
      "title": "Warnings Open",
      "type": "object"
    }
  },
  "$id": "pumi.facts.v1.WarningsOpen.jsonschema.bundle.json",
  "$ref": "#/$defs/pumi.facts.v1.WarningsOpen.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
