{
  "$defs": {
    "pumi.facts.v1.ConformanceAudit.Counts.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Counts are the verdicts counted.",
      "properties": {
        "fail": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "The failing verdicts."
        },
        "models": {
          "description": "The model of each counted verdict, so a policy can require a\n different model later.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "pass": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "The passing verdicts."
        }
      },
      "title": "Counts",
      "type": "object"
    },
    "pumi.facts.v1.ConformanceAudit.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "ConformanceAudit is conformance.audit: the passing and failing independent\n auditor verdicts on the tree (decision 0137).",
      "properties": {
        "plan": {
          "default": "",
          "description": "The plan.",
          "type": "string"
        },
        "tree": {
          "default": "",
          "description": "The tree.",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/pumi.facts.v1.ConformanceAudit.Counts.jsonschema.json",
          "description": "The counts."
        }
      },
      "title": "Conformance Audit",
      "type": "object"
    }
  },
  "$id": "pumi.facts.v1.ConformanceAudit.jsonschema.bundle.json",
  "$ref": "#/$defs/pumi.facts.v1.ConformanceAudit.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
