# A workflow of the first workflow's spec state and its archive state only,
# for the shown run of the OpenSpec adapter (getpumi/pumi#146): the spec
# check program validates the plan's change and the spec gate decides from
# its spec.valid (decisions 0272, 0277 and 0299); the archive step then
# archives the change and returns the tree (decisions 0278 and 0282), and
# the plan is done. Each state otherwise escalates. It is test data, not a
# workflow of the release (decision 0166).
name: "spec-archive"
version: "1"
initial: "spec"

# The superstate of the states of a plan that is not finished.
states {
  name: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.cancel.requested" }
    target: "cancelled"
    action: "cancel"
  }
}

states {
  name: "spec"
  parent: "active"
  gate: "spec"
  invoke {
    role: ROLE_GATE
    kind: KIND_CHECK
    component: "spec"
    task: "validate-spec"
    output_message: "pumi.workflow.v1.SpecCheckOutput"
  }
  transitions {
    trigger { result {} }
    target: "archiving"
    action: "spec"
  }
  transitions {
    trigger { result {} }
    target: "spec-escalated"
    action: "escalate"
  }
  transitions {
    trigger { cap_reached {} }
    target: "spec-escalated"
    action: "escalate"
  }
  transitions {
    trigger { failed {} }
    target: "spec-escalated"
    action: "escalate"
  }
}

states {
  name: "spec-escalated"
  parent: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "spec"
    action: "resume"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "spec-escalated"
    action: "escalate"
  }
}

states {
  name: "archiving"
  parent: "active"
  invoke {
    role: ROLE_GATE
    kind: KIND_CHECK
    component: "spec"
    task: "archive-change"
    returns_tree: true
  }
  transitions {
    trigger { result {} }
    target: "done"
    action: "advance"
  }
  transitions {
    trigger { result {} }
    target: "archiving-escalated"
    action: "escalate"
  }
  transitions {
    trigger { cap_reached {} }
    target: "archiving-escalated"
    action: "escalate"
  }
  transitions {
    trigger { failed {} }
    target: "archiving-escalated"
    action: "escalate"
  }
}

states {
  name: "archiving-escalated"
  parent: "active"
  wait {}
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "archiving"
    action: "resume"
  }
  transitions {
    trigger { event: "dev.getpumi.escalation.resolved" }
    target: "archiving-escalated"
    action: "escalate"
  }
}

states {
  name: "done"
  final { merged: true }
}

states {
  name: "cancelled"
  final {}
}
