{
  "$defs": {
    "pumi.runner.v1.HeartbeatRequest.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "HeartbeatRequest is the request of Heartbeat.",
      "patternProperties": {
        "^(lease_number)$": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "The lease number from Claim."
        }
      },
      "properties": {
        "invocation": {
          "default": "",
          "description": "The invocation.",
          "type": "string"
        },
        "leaseNumber": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "The lease number from Claim."
        }
      },
      "title": "Heartbeat Request",
      "type": "object"
    }
  },
  "$id": "pumi.runner.v1.HeartbeatRequest.jsonschema.bundle.json",
  "$ref": "#/$defs/pumi.runner.v1.HeartbeatRequest.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
